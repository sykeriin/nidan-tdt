      "type": "string",
      "title": "Detector",
      "description": "rule | residual | ml | physics"
     },
     "value": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Value"
     },
     "threshold": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Threshold"
     },
     "explanation": {
      "type": "string",
      "title": "Explanation"
     },
